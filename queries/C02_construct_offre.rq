PREFIX lod:     <https://data.lod-school.ma/ontology#>
PREFIX schema:  <https://schema.org/>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>

CONSTRUCT {
    ?offre a lod:InternshipOffer ;
           schema:title ?titre ;
           lod:postedBy ?comp ;
           lod:requiresSkill ?skill ;
           schema:jobLocation ?ville ;
           lod:status ?statut .
    ?comp schema:name ?entreprise .
    ?skill skos:prefLabel ?competence .
}
WHERE {
    ?offre a lod:InternshipOffer ;
           schema:title ?titre ;
           lod:postedBy ?comp ;
           lod:requiresSkill ?skill ;
           schema:jobLocation ?ville ;
           lod:status ?statut .
    ?comp schema:name ?entreprise .
    ?skill skos:prefLabel ?competence .
    FILTER (lang(?competence) = "fr")
}
LIMIT 100
